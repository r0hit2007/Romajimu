# Silent SOS Backend Environment Variables

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/silent_sos?schema=public"

# JWT Secrets (generate 64-char random strings in production)
JWT_ACCESS_SECRET="silent_sos_jwt_access_super_secret_key_production_2026_change_in_prod"
JWT_REFRESH_SECRET="silent_sos_jwt_refresh_super_secret_key_production_2026_change_in_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional: HuggingFace Token for Gemma AI Backend Service
HF_TOKEN=""

# CORS Allowed Origins (comma-separated or wildcard for dev)
CORS_ORIGIN="*"
